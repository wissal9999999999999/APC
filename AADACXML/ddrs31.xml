	<description xml:lang="fr">
		<titre>Analyse du Cycle de Vie</titre>
		<langue>Français</langue>
		<objectif>
			<p>Connaître les étapes principales d'une ACV, être capable de la comprendre et d'exploiter ses résultats.</p>
			<p>Prendre conscience des enjeux environnementaux dans le numérique</p>
		</objectif>
		<programme>
			<ul>
				<li>Le système terre et les effets des activités anthropiques sur la biosphère</li>
				<li>Méthodologie générale de l'ACV :
					<ul>
						<li>Dans quel but faire une ACV ?</li>
						<li>Quels indicateurs utiliser et à quels moments impactent-ils l'environnement ?</li>
						<li>Les étapes de l'ACV</li>
						<li>Analyse et critique des résultats</li>
					</ul>
				</li>
				<li>Quelques notions d'éco-conception</li>
			</ul>
		</programme>
		<pre-requis>
			<p>Aucun</p>
		</pre-requis>
		<documentation>
			<p>aucun</p>
		</documentation>
		<evaluation>
			<ul>
				<li>Examen final : 50%</li>
				<li>Projet : 50%</li>
			</ul>
		</evaluation>
	</description>
	<description xml:lang="en">
		<titre>Life Cycle Analysis</titre>
		<langue>English</langue>
		<objectif>
			<p>Know the main stages of an LCA, be able to understand it and use its results.</p>
			<p>Become aware of environmental issues in digital technology.</p>
		</objectif>
		<programme>
			<ul>
				<li>The Earth system and the effects of human activities on the biosphere</li>
				<li>General LCA methodology:
					<ul>
						<li>What is the purpose of conducting an LCA?</li>
						<li>Which indicators should be used and when do they impact the environment?</li>
						<li>The stages of an LCA</li>
						<li>Analysis and critique of the results</li>
					</ul>
				</li>
				<li>Some concepts of eco-design</li>
			</ul>
		</programme>
		<pre-requis>
			<p>None</p>
		</pre-requis>
		<documentation>
			<p>None</p>
		</documentation>
		<evaluation>
			<ul>
				<li>Final exam : 50%</li>
				<li>Project : 50%</li>
			</ul>
		</evaluation>
	</description>
